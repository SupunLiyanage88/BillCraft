{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist-api",
    "rootDir": "./api",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["api/**/*.ts"]
}
